`timescale 1 ps/ 1 ps
module trafficController_vlg_vec_tst();
// constants                                           
// general purpose registers
reg btn;
reg clk;
reg rst;
// wires                                               
wire green;
wire PDLED;
wire red;
wire [2:0] state_out;
wire yellow;

// assign statements (if any)                          
trafficController i1 (
// port map - connection between master ports and signals/registers   
	.btn(btn),
	.clk(clk),
	.green(green),
	.PDLED(PDLED),
	.red(red),
	.rst(rst),
	.state_out(state_out),
	.yellow(yellow)
);
initial 
begin 
#1000000 $finish;
end 

// rst
initial
begin
	rst = 1'b0;
end 

// clk
initial
begin
	repeat(12)
	begin
		clk = 1'b0;
		clk = #40000 1'b1;
		# 40000;
	end
	clk = 1'b0;
end 

// btn
initial
begin
	btn = 1'b0;
	btn = #110000 1'b1;
	btn = #20000 1'b0;
	btn = #220000 1'b1;
	btn = #140000 1'b0;
end 
endmodule

