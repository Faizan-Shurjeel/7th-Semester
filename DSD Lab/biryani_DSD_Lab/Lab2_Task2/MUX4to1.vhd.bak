library ieee;
use ieee.std_logic_1164.all;

entity MUX4to1 is
    port (
        D0, D1, D2, D3 : in  std_logic;            -- Data inputs
        SEL            : in  std_logic_vector(1 downto 0); -- Select input
        Y              : out std_logic             -- Output
    );
end MUX4to1;

architecture Behavioral of MUX4to1 is
begin
    process (D0, D1, D2, D3, SEL)
    begin
        case SEL is
            when "00" => Y <= D0;
            when "01" => Y <= D1;
            when "10" => Y <= D2;
            when "11" => Y <= D3;
            when others => Y <= '0';  -- default case (safe)
        end case;
    end process;
end Behavioral;
