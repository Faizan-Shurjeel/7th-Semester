`timescale 1 ps/ 1 ps

module Alarm (
	DOOR,
	SBELT,
	IGNITION,
	WARNING);
input 	DOOR;
input 	SBELT;
input 	IGNITION;
output 	WARNING;

// Design Ports Information
// WARNING	=>  Location: PIN_G19,	 I/O Standard: 2.5 V,	 Current Strength: Default
// IGNITION	=>  Location: PIN_AC28,	 I/O Standard: 2.5 V,	 Current Strength: Default
// DOOR	=>  Location: PIN_AB28,	 I/O Standard: 2.5 V,	 Current Strength: Default
// SBELT	=>  Location: PIN_AC27,	 I/O Standard: 2.5 V,	 Current Strength: Default


wire gnd;
wire vcc;
wire unknown;

assign gnd = 1'b0;
assign vcc = 1'b1;
assign unknown = 1'bx;

tri1 devclrn;
tri1 devpor;
tri1 devoe;
wire \WARNING~output_o ;
wire \IGNITION~input_o ;
wire \SBELT~input_o ;
wire \DOOR~input_o ;
wire \U4|out1a~0_combout ;


hard_block auto_generated_inst(
	.devpor(devpor),
	.devclrn(devclrn),
	.devoe(devoe));

// Location: IOOBUF_X69_Y73_N16
cycloneive_io_obuf \WARNING~output (
	.i(\U4|out1a~0_combout ),
	.oe(vcc),
	.seriesterminationcontrol(16'b0000000000000000),
	.devoe(devoe),
	.o(\WARNING~output_o ),
	.obar());
// synopsys translate_off
defparam \WARNING~output .bus_hold = "false";
defparam \WARNING~output .open_drain_output = "false";
// synopsys translate_on

// Location: IOIBUF_X115_Y14_N1
cycloneive_io_ibuf \IGNITION~input (
	.i(IGNITION),
	.ibar(gnd),
	.o(\IGNITION~input_o ));
// synopsys translate_off
defparam \IGNITION~input .bus_hold = "false";
defparam \IGNITION~input .simulate_z_as = "z";
// synopsys translate_on

// Location: IOIBUF_X115_Y15_N8
cycloneive_io_ibuf \SBELT~input (
	.i(SBELT),
	.ibar(gnd),
	.o(\SBELT~input_o ));
// synopsys translate_off
defparam \SBELT~input .bus_hold = "false";
defparam \SBELT~input .simulate_z_as = "z";
// synopsys translate_on

// Location: IOIBUF_X115_Y17_N1
cycloneive_io_ibuf \DOOR~input (
	.i(DOOR),
	.ibar(gnd),
	.o(\DOOR~input_o ));
// synopsys translate_off
defparam \DOOR~input .bus_hold = "false";
defparam \DOOR~input .simulate_z_as = "z";
// synopsys translate_on

// Location: LCCOMB_X114_Y17_N8
cycloneive_lcell_comb \U4|out1a~0 (
// Equation(s):
// \U4|out1a~0_combout  = (\IGNITION~input_o  & ((!\DOOR~input_o ) # (!\SBELT~input_o )))

	.dataa(\IGNITION~input_o ),
	.datab(gnd),
	.datac(\SBELT~input_o ),
	.datad(\DOOR~input_o ),
	.cin(gnd),
	.combout(\U4|out1a~0_combout ),
	.cout());
// synopsys translate_off
defparam \U4|out1a~0 .lut_mask = 16'h0AAA;
defparam \U4|out1a~0 .sum_lutc_input = "datac";
// synopsys translate_on

assign WARNING = \WARNING~output_o ;

endmodule

module hard_block (

	devpor,
	devclrn,
	devoe);

// Design Ports Information
// ~ALTERA_ASDO_DATA1~	=>  Location: PIN_F4,	 I/O Standard: 2.5 V,	 Current Strength: Default
// ~ALTERA_FLASH_nCE_nCSO~	=>  Location: PIN_E2,	 I/O Standard: 2.5 V,	 Current Strength: Default
// ~ALTERA_DCLK~	=>  Location: PIN_P3,	 I/O Standard: 2.5 V,	 Current Strength: Default
// ~ALTERA_DATA0~	=>  Location: PIN_N7,	 I/O Standard: 2.5 V,	 Current Strength: Default
// ~ALTERA_nCEO~	=>  Location: PIN_P28,	 I/O Standard: 2.5 V,	 Current Strength: 8mA

input 	devpor;
input 	devclrn;
input 	devoe;

wire gnd;
wire vcc;
wire unknown;

assign gnd = 1'b0;
assign vcc = 1'b1;
assign unknown = 1'bx;

wire \~ALTERA_ASDO_DATA1~~padout ;
wire \~ALTERA_FLASH_nCE_nCSO~~padout ;
wire \~ALTERA_DATA0~~padout ;
wire \~ALTERA_ASDO_DATA1~~ibuf_o ;
wire \~ALTERA_FLASH_nCE_nCSO~~ibuf_o ;
wire \~ALTERA_DATA0~~ibuf_o ;


endmodule
