// synopsys translate_on

// Location: LCCOMB_X114_Y40_N18
cycloneive_lcell_comb \state.S0~feeder (
// Equation(s):
// \state.S0~feeder_combout  = \W~input_o 

	.dataa(gnd),
	.datab(gnd),
	.datac(gnd),
	.datad(\W~input_o ),
	.cin(gnd),
	.combout(\state.S0~feeder_combout ),
