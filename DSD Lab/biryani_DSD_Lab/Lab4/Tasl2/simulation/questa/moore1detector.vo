// synopsys translate_off
defparam \state.S0 .is_wysiwyg = "true";
defparam \state.S0 .power_up = "low";
// synopsys translate_on

// Location: LCCOMB_X114_Y40_N16
cycloneive_lcell_comb \next_state.S2~0 (
// Equation(s):
// \next_state.S2~0_combout  = (\W~input_o  & \state.S0~q )

	.dataa(gnd),
	.datab(\W~input_o ),
	.datac(gnd),
	.datad(\state.S0~q ),
	.cin(gnd),
	.combout(\next_state.S2~0_combout ),
	.cout());
// synopsys translate_off
defparam \next_state.S2~0 .lut_mask = 16'hCC00;
defparam \next_state.S2~0 .sum_lutc_input = "datac";
// synopsys translate_on

// Location: FF_X114_Y40_N17
dffeas \state.S2 (
	.clk(\clk~input_o ),
	.d(\next_state.S2~0_combout ),
	.asdata(vcc),
	.clrn(\Resetn~input_o ),
	.aload(gnd),
	.sclr(gnd),
	.sload(gnd),
	.ena(vcc),
	.devclrn(devclrn),
	.devpor(devpor),
	.q(\state.S2~q ),
