// synopsys translate_off
defparam \state.S0~feeder .lut_mask = 16'hFF00;
defparam \state.S0~feeder .sum_lutc_input = "datac";
// synopsys translate_on

// Location: IOIBUF_X115_Y14_N1
cycloneive_io_ibuf \Resetn~input (
