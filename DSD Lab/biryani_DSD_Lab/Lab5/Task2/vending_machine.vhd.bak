library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity vending_machine is
    Port (
        clk         : in  STD_LOGIC;
        reset       : in  STD_LOGIC;
        rs1, rs2, rs4, rs8 : in  STD_LOGIC;
        fanta, cola, sprite : in  STD_LOGIC;
        enter       : in  STD_LOGIC;
        total_money : out STD_LOGIC_VECTOR(7 downto 0);
        change      : out STD_LOGIC_VECTOR(7 downto 0);
        dispense    : out STD_LOGIC_VECTOR(2 downto 0)
    );
end vending_machine;

architecture FSM of vending_machine is

    -- States
    type state_type is (IDLE, WAIT_MONEY, WAIT_SELECTION, DISPENSE, RETURN_CHANGE);
    signal current_state, next_state : state_type;

    -- Internal signals
    signal money_sum : integer range 0 to 255 := 0;
    signal next_money : integer range 0 to 255 := 0;
    signal drink_cost : integer range 0 to 10 := 0;
    signal selected_drink : STD_LOGIC_VECTOR(2 downto 0) := "000";

begin

    ------------------------------------------------------------
    -- Sequential process: state register
    ------------------------------------------------------------
    process(clk, reset)
    begin
        if reset = '1' then
            current_state <= IDLE;
            money_sum <= 0;
        elsif rising_edge(clk) then
            current_state <= next_state;
            money_sum <= next_money;
        end if;
    end process;

    ------------------------------------------------------------
    -- Combinational process: next state logic and outputs
    ------------------------------------------------------------
    process(current_state, rs1, rs2, rs4, rs8, fanta, cola, sprite, enter, money_sum)
    begin
        -- Default values
        next_state <= current_state;
        next_money <= money_sum;
        drink_cost <= 0;
        selected_drink <= "000";
        dispense <= "000";
        change <= (others => '0');

        case current_state is
            ------------------------------------------------
            when IDLE =>
                next_money <= 0;
                if (rs1 = '1' or rs2 = '1' or rs4 = '1' or rs8 = '1') then
                    next_state <= WAIT_MONEY;
                end if;

            ------------------------------------------------
            when WAIT_MONEY =>
                -- Add inserted money
                if rs1 = '1' then
                    next_money <= money_sum + 1;
                elsif rs2 = '1' then
                    next_money <= money_sum + 2;
                elsif rs4 = '1' then
                    next_money <= money_sum + 4;
                elsif rs8 = '1' then
                    next_money <= money_sum + 8;
                end if;

                -- Wait for selection or ENTER
                if (fanta = '1' or cola = '1' or sprite = '1') then
                    next_state <= WAIT_SELECTION;
                elsif enter = '1' then
                    next_state <= RETURN_CHANGE;
                end if;

            ------------------------------------------------
            when WAIT_SELECTION =>
                -- Determine drink cost and selected drink
                if fanta = '1' then
                    drink_cost <= 3;
                    selected_drink <= "001";
                elsif cola = '1' then
                    drink_cost <= 4;
                    selected_drink <= "010";
                elsif sprite = '1' then
                    drink_cost <= 5;
                    selected_drink <= "100";
                end if;

                if enter = '1' then
                    if money_sum >= drink_cost and drink_cost /= 0 then
                        next_state <= DISPENSE;
                    else
                        next_state <= RETURN_CHANGE;
                    end if;
                end if;

            ------------------------------------------------
            when DISPENSE =>
                dispense <= selected_drink;
                change <= std_logic_vector(to_unsigned(money_sum - drink_cost, 8));
                next_money <= 0;
                next_state <= IDLE;

            ------------------------------------------------
            when RETURN_CHANGE =>
                -- Return all money if no drink or insufficient funds
                change <= std_logic_vector(to_unsigned(money_sum, 8));
                next_money <= 0;
                next_state <= IDLE;

            ------------------------------------------------
            when others =>
                next_state <= IDLE;
        end case;

        total_money <= std_logic_vector(to_unsigned(money_sum, 8));
    end process;

end FSM;
