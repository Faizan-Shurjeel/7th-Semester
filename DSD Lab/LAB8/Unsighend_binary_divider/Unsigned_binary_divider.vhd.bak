-- Binary Divider: 8-bit dividend / 4-bit divisor = 4-bit quotient
-- Uses shift-subtract algorithm

library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

-- Entity Declaration
entity Unsigned_binary_divider is
    Port ( 
        clk       : in  STD_LOGIC;
        reset     : in  STD_LOGIC;
        start     : in  STD_LOGIC;
       -- dividend  : in  STD_LOGIC_VECTOR(7 downto 0);
        --divisor   : in  STD_LOGIC_VECTOR(3 downto 0);
        quotient  : out STD_LOGIC_VECTOR(3 downto 0);
        remainder : out STD_LOGIC_VECTOR(3 downto 0);
        done      : out STD_LOGIC;
        overflow  : out STD_LOGIC
    );
end Unsigned_binary_divider;

architecture Behavioral of Unsigned_binary_divider is
    
    -- FSM States
type state_type is (IDLE, LOAD, CHECK, SUBTRACT, SHIFT, DONE_STATE);
signal current_state, next_state : state_type;
 
    -- Internal registers
signal X_reg : STD_LOGIC_VECTOR(8 downto 0):='0' & X"47";  -- 9-bit dividend register
signal Y_reg : STD_LOGIC_VECTOR(3 downto 0):= "1101";  -- 4-bit divisor register
signal Q_reg : STD_LOGIC_VECTOR(3 downto 0);  -- 4-bit quotient register
signal counter : integer range 0 to 4;         -- Shift counter
    
    -- Internal signals
 signal upper_dividend : STD_LOGIC_VECTOR(4 downto 0);  -- Upper 5 bits for comparison
 signal subtractor_result : STD_LOGIC_VECTOR(4 downto 0);
 signal can_subtract : STD_LOGIC;
    
begin
    
    -- Extract upper 5 bits of dividend register for comparison
    upper_dividend <= X_reg(8 downto 4);
    
    -- Subtractor: upper_dividend - divisor
    subtractor_result <= std_logic_vector(unsigned('0' & upper_dividend(3 downto 0)) - unsigned('0' & Y_reg));
    
    -- Check if subtraction is possible (no borrow)
    can_subtract <= '1' 
	when 
	(unsigned(upper_dividend) >= unsigned('0' & Y_reg)) 
	else '0';
    
    -- State Register Process
    process(clk, reset)
    begin
        if reset = '1' then
            current_state <= IDLE;
        elsif rising_edge(clk) then
            current_state <= next_state;
        end if;
    end process;
    
    -- Next State Logic
    process(current_state, start, can_subtract, counter)
    begin
        next_state <= current_state;
        
        case current_state is
            when IDLE =>
                if start = '1' then
                    next_state <= LOAD;
                end if;
                
            when LOAD =>  -- values initialize
                next_state <= CHECK;
                
            when CHECK =>
                if counter = 4 then
                    next_state <= DONE_STATE;
                elsif can_subtract = '1' then
                    next_state <= SUBTRACT;
                else
                    next_state <= SHIFT;
                end if;
                
            when SUBTRACT =>
                if counter = 4 then
                    next_state <= DONE_STATE;
                else
                    next_state <= CHECK;
                end if;
                
            when SHIFT =>
                if counter = 4 then
                    next_state <= DONE_STATE;
                else
                    next_state <= CHECK;
                end if;
                
            when DONE_STATE =>
                if start = '0' then
                    next_state <= IDLE;
                end if;
        end case;
    end process;
    
    -- Datapath Process
    process(clk, reset)
    begin
        if reset = '1' then
            X_reg <= (others => '0');
            Y_reg <= (others => '0');
            Q_reg <= (others => '0');
            counter <= 0;
            
        elsif rising_edge(clk) then
            case current_state is
                when IDLE =>
                    counter <= 0;
                    Q_reg <= (others => '0');
                    
                when LOAD =>
                    -- Load dividend into X register (left-aligned with extra bit)
                    --X_reg <= '0' & dividend;
                    --Y_reg <= divisor;
                    counter <= 0;
                    
                when CHECK =>
                    -- Do nothing, just check condition
                    null;
                    
                when SUBTRACT =>
          -- Perform subtraction and store result in upper part
                    X_reg(8 downto 4) <= subtractor_result;
                    -- Shift left and set quotient bit to 1
                    X_reg <= X_reg(7 downto 0) & '0';
                    Q_reg <= Q_reg(2 downto 0) & '1';
                    counter <= counter + 1;
                    
                when SHIFT =>
          -- Just shift left and set quotient bit to 0
                    X_reg <= X_reg(7 downto 0) & '0';
                    Q_reg <= Q_reg(2 downto 0) & '0';
                    counter <= counter + 1;
                    
                when DONE_STATE =>
          -- Hold values
                    null;
            end case;
        end if;
    end process;
    
    -- Output Logic
    quotient <= Q_reg;
    remainder <= X_reg(8 downto 5);  -- Upper 4 bits contain remainder
    done <= '1' when current_state = DONE_STATE else '0';
    overflow <= '0';  -- Basic divider doesn't check overflow
    
end Behavioral;